{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gloginkabg",
	"main": "src/index.js",
	"compatibility_date": "2026-11-01",
	"workers_dev": true,
	"observability": {
		"enabled": true
	},
	"vars": {
		// Pages allowed to call the API. Add your custom domain here if you get one.
		"ALLOWED_ORIGINS": "https://gloginkabg.neocities.org,http://localhost:3100,http://127.0.0.1:3100",
		// "Общо" in the footer = this number + the real unique visits.
		"START_TOTAL": "12000"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gloginkabg",
			"database_id": "2516c084-34b4-4424-8567-0bad999b0162"
		}
	]
}